{
  "name": "tapstate-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:docs:check": "node tools/check-ui-docs.mjs",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "format": "pnpm exec oxfmt . '!apps/web/app/routeTree.gen.ts' '!apps/cloud/app/routeTree.gen.ts'",
    "format:check": "pnpm exec oxfmt --check . '!apps/web/app/routeTree.gen.ts' '!apps/cloud/app/routeTree.gen.ts'",
    "typecheck": "pnpm -r typecheck",
    "lint:code": "pnpm exec oxlint .",
    "lint": "pnpm lint:code && pnpm format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^6.0.3"
  }
},
