{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "packages/ui/src/**",
    "docs/engineering/ui/source-atlas.json",
    "docs/engineering/ui/token-catalog.json",
    "docs/engineering/ui/page-evidence.json",
    "docs/engineering/ui/component-evidence.json",
    "docs/engineering/ui/source-coverage.md",
    "docs/engineering/ui/token-reference.md",
    "docs/engineering/ui/typography-reference.md",
    "apps/web/features/pipelines/start-checks/__fixtures__/*.json"
  ],
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true
  }
}
